# ---- Server ----
PORT=5001
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# ---- Postgres ----
PG_HOST=localhost
PG_PORT=5432
PG_USER=scheduler
PG_PASSWORD=scheduler
PG_DB=scheduler

# ---- Redis / BullMQ ----
REDIS_URL=redis://localhost:6379

# ---- Elasticsearch ----
ES_URL=http://localhost:9200

# ---- Worker behavior ----
# How many jobs run in parallel per worker
WORKER_CONCURRENCY=5
# Minimum time between individual email sends (provider throttling)
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Maximum emails a single sender can send per rolling hour window
MAX_EMAILS_PER_HOUR_PER_SENDER=10
# If no per-sender limit set, this global cap applies
MAX_EMAILS_PER_HOUR_GLOBAL=200

# ---- Ethereal Email (fake SMTP) ----
# Create a test account at https://ethereal.email and paste creds here.
# If left blank the app creates a fresh Ethereal test account at boot.
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASS=

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback
